# Copy to .env.local and edit. Every value has a working default, so this file
# is documentation rather than a requirement.

# Where the local Ollama daemon lives.
OLLAMA_HOST=http://127.0.0.1:11434

# Model tag. Must be pulled: ollama pull gemma4:e2b
KANTOPRINT_MODEL=gemma4:e2b

# llama.cpp threads. Defaults to the physical core count read from /proc/cpuinfo.
# KANTOPRINT_THREADS=10

# Context window. 8192 measured no better and much slower on this box.
KANTOPRINT_CTX=2048

# Vision input size. 256 loses the artwork, 384 classifies correctly.
KANTOPRINT_THUMB=384

# Size used when the operator turns on "Read small type". Roughly doubles the
# encode cost per page.
KANTOPRINT_THUMB_DETAIL=512

# Raster DPI for PDF pages before downscaling. The edge band is derived from it.
KANTOPRINT_DPI=150

# Pages analysed per file. Past the cap the card says how many were skipped.
KANTOPRINT_MAX_PAGES=20

# Hard ceiling on pdftoppm and ghostscript. A malformed PDF cannot hang a
# request past this.
KANTOPRINT_RASTER_TIMEOUT=45000

# Hard ceiling on one vision call, so a wedged daemon cannot stall the queue.
KANTOPRINT_VISION_TIMEOUT=90000